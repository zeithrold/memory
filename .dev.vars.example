CLERK_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
ANALYTICS_READ_TOKEN=
# Optional. Defaults to the frontend API host encoded in the publishable key.
CLERK_ISSUER=
# Exact origin, including port during development.
APP_ORIGIN=http://localhost:3000
# Required to store a per-account model credential for the catalog agent.
# 64 hex characters (32 bytes); generate with `openssl rand -hex 32`. Leaving it
# empty keeps the catalog usable but read-only: the settings endpoint refuses to
# store a key instead of writing it in plaintext.
AGENT_SETTINGS_KEY=
# Optional. Filling this in reports local failures to Sentry as environment
# "stage"; leaving it empty keeps the SDK inert.
SENTRY_DSN=
# Optional overrides. The environment is derived from APP_ORIGIN (http or
# localhost means stage) and the sample rate defaults to 1 for stage, 0.5 for
# production.
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
