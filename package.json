{
  "name": "memory",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "deploy": "tsx scripts/deploy-check.ts && pnpm build && pnpm check:bundle && wrangler deploy --config dist/server/wrangler.json",
    "plugin:build": "tsx scripts/build-plugin.ts",
    "skill:configure": "node skills/shared-memory/scripts/configure.mjs",
    "oauth:check": "tsx scripts/oauth-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "e2e:build": "tsx scripts/e2e-build.ts",
    "test:e2e": "pnpm e2e:prepare && pnpm test:browser && pnpm test:a11y",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:check-tenants:local": "tsx scripts/check-tenant-integrity.ts --local",
    "db:check-tenants:remote": "tsx scripts/check-tenant-integrity.ts --remote",
    "check": "tsx scripts/verification-metadata.ts && zt check --root . --module web --profile frontend",
    "lint:css": "ztd-css ./css-check.config.mjs",
    "e2e:prepare": "pnpm e2e:build && pnpm check:bundle",
    "test:browser": "playwright test",
    "test:a11y": "tsx scripts/e2e-mock-build.ts && playwright test --config playwright.mock.config.ts",
    "test:artifacts": "tsx scripts/verify-failure-artifacts.ts",
    "check:code": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/cloudflare": "10.74.0",
    "@sentry/react": "10.74.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@ztd-me/frontend": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vinext": "1.0.0-beta.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "1.62.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^24.19.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@ztd-me/eslint": "0.1.1",
    "@ztd-me/frontend-checks": "0.1.1",
    "eslint": "^10.11.0",
    "playwright-core": "1.62.0",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
