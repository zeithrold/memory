{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "APP_ORIGIN": "https://memory.ztd.me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-memory",
      "database_id": "b0fff0a7-7b5d-423a-99f5-86a87a05dd0b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "workflows": [
    {
      "name": "memory-catalog",
      "binding": "CATALOG_WORKFLOW",
      "class_name": "CatalogWorkflow",
      "limits": {
        "steps": 400
      },
      "concurrency": {
        "limit": 4
      }
    }
  ],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "shared-memory",
      "remote": true
    }
  ]
}
